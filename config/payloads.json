{
  "schema": 1,
  "payloads": {
    "kstuff-upstream": {
      "name": "kstuff (EchoStretch)",
      "kind": "github",
      "repo": "EchoStretch/kstuff-lite",
      "asset_regex": "^kstuff\\.elf$",
      "include_prerelease": true,
      "delay_ms": 1000,
      "note": "Public kstuff does not imply FPKG support on PS5 FW 13.60."
    },
    "kstuff-fpkg-manual": {
      "name": "kstuff 1.13-fpkg-dr-test8-rest-fast (user-supplied)",
      "kind": "manual",
      "manual_filename": "kstuff1.13-fpkg-dr-test8-rest-fast.elf",
      "delay_ms": 1000,
      "note": "User-supplied Discord ELF. Embedded banner: 'Welcome To Kstuff Lite 1.13-fpkg-dr-test8-rest'. FAST references present. Local-only; verify compatibility and provenance. This file MUST NOT be committed to a public repository.",
      "sha256": "221fa41c43597677c1153d5224174be9062105c0c9a3379e96cb45d278aa52fc"
    },
    "elfldr": {
      "name": "ELF Loader",
      "kind": "github",
      "repo": "ps5-payload-dev/elfldr",
      "asset_regex": "^elfldr-ps5\\.elf$",
      "include_prerelease": true,
      "delay_ms": 1000
    },
    "ftpsrv": {
      "name": "FTP Server",
      "kind": "github",
      "repo": "ps5-payload-dev/ftpsrv",
      "asset_regex": "^ftpsrv-ps5\\.elf$",
      "include_prerelease": true,
      "delay_ms": 1000
    },
    "nanodns": {
      "name": "nanoDNS",
      "kind": "github",
      "repo": "drakmor/nanoDNS",
      "asset_regex": "^nanodns\\.elf$",
      "include_prerelease": true,
      "delay_ms": 1000
    },
    "websrv": {
      "name": "Web Server",
      "kind": "github",
      "repo": "ps5-payload-dev/websrv",
      "asset_regex": "^websrv-ps5\\.elf$",
      "include_prerelease": true,
      "delay_ms": 1000
    },
    "shadowmountplus": {
      "name": "ShadowMountPlus",
      "kind": "github",
      "repo": "drakmor/ShadowMountPlus",
      "asset_regex": "^shadowmountplus\\.elf$",
      "include_prerelease": true,
      "delay_ms": 1000
    },
    "klogsrv": {
      "name": "Kernel Log Server",
      "kind": "github",
      "repo": "ps5-payload-dev/klogsrv",
      "asset_regex": "^klogsrv-ps5\\.elf$",
      "include_prerelease": true,
      "delay_ms": 1000
