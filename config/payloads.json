    "dump-forge": {
      "name": "Dump Forge",
      "kind": "github",
      "repo": "quer3q/ps5-dump-forge",
      "asset_regex": "^ps5-dump-forge-[^/]+-ps5\\.elf$",
      "include_prerelease": true,
      "delay_ms": 1000
    },
    "zftpd": {
      "name": "zftpd (alternative FTP)",
      "kind": "github",
      "repo": "seregonwar/zftpd",
      "asset_regex": "^zftpd-ps5-v[^/]+\\.elf$",
      "include_prerelease": true,
      "delay_ms": 1000
    },
    "hush": {
      "name": "Hush",
      "kind": "github",
      "repo": "disco-trooper/hush",
      "asset_regex": "^hush\\.elf$",
      "include_prerelease": true,
      "delay_ms": 0,
      "note": "Disables recent gameplay recording by patching SceAvCapture; supported on FW 13.60 per developer."
