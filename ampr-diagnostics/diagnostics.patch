+#[cfg(feature="mem_report")]
+fn clock()->u64 {super::stats::now()}
+
+#[cfg(feature="mem_report")]
+pub(crate) fn begin(mut item:Item,path:&[u8],truncated:bool)->u64 {
+    let id=NEXT_ID.fetch_add(1,Ordering::Relaxed);
+    if id==0 {DROPPED.fetch_add(1,Ordering::Relaxed);return 0;}
+    let now=clock();
+    let _=BOOT_NS.compare_exchange(0,now.max(1),Ordering::Relaxed,Ordering::Relaxed);
+    item.id=id;
+    let n=path.len().min(PATH);item.path[..n].copy_from_slice(&path[..n]);
+    item.path_len=n as u8;item.path_truncated=truncated || path.len()>PATH;
+    let _=with_store(true,|s|s.begin(item,now));
+    id
+}
+#[cfg(feature="mem_report")]
+pub(crate) fn change(id:u64,stage:u8) {let _=with_store(true,|s|s.change(id,stage,0,clock(),false));}
+#[cfg(feature="mem_report")]
+pub(crate) fn finish(id:u64,stage:u8,result:i64) {let _=with_store(true,|s|s.change(id,stage,result,clock(),true));}
+
+#[cfg(feature="mem_report")]
+pub(crate) fn begin_read(read:&super::reactor::ActiveRead)->u64 {
+    let job=unsafe {read.job.as_ref()};
+    let mut path=[0u8;PATH+1];
+    let n=super::index::probe_file_path(read.desc.fileId,&mut path).unwrap_or(0);
+    begin(Item {parent:job.map_or(0,|j|j.diagId),source_job:job.map_or(0,|j|j.id),
+        kind:READ,stage:READ_LISTED,fd:read.desc.fd,file_id:read.desc.fileId,
+        offset:read.desc.offset,bytes:read.desc.length,command:read.commandIndex as u32,
+        priority:read.aioPrio as u32,..Item::EMPTY},&path[..n],n==PATH)
+}
