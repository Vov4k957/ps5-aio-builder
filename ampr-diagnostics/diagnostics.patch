+//! Bounded debug-only operation history. Producers never wait for a reader.
+//! A dropped update makes the active table potentially stale; the loss is
+//! reported forever for that module instance instead of hiding a lost finish.
+
+use core::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use super::sync::SyncCell;
+
+pub(crate) const PROTOCOL: u64 = 1;
+pub(crate) const ACTIVE_CAP: usize = 1024;
+pub(crate) const EVENT_CAP: usize = 8192;
+pub(crate) const PAGE: usize = 64;
+pub(crate) const PATH: usize = 96;
+pub(crate) const STAGES: usize = 32;
+pub(crate) const BINS: usize = 32;
+pub(crate) const JOB: u8 = 1;
+pub(crate) const READ: u8 = 2;
+pub(crate) const PREAD: u8 = 3;
+pub(crate) const JOB_ACCEPTED: u8 = 1;
+pub(crate) const JOB_ISSUED: u8 = 2;
+pub(crate) const JOB_READ_DONE: u8 = 3;
+pub(crate) const JOB_NOTIFIED: u8 = 4;
+pub(crate) const JOB_RELEASED: u8 = 5;
+pub(crate) const READ_LISTED: u8 = 10;
+pub(crate) const READ_ACCEPTED: u8 = 11;
+pub(crate) const READ_OBSERVED: u8 = 12;
+pub(crate) const READ_REMOVED: u8 = 13;
+pub(crate) const PREAD_QUEUED: u8 = 20;
+pub(crate) const PREAD_RUNNING: u8 = 21;
+pub(crate) const PREAD_FINISHED: u8 = 22;
+
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct Item {
+    pub(crate) id: u64,
+    pub(crate) parent: u64,
+    pub(crate) source_job: u64,
+    pub(crate) created_ns: u64,
+    pub(crate) changed_ns: u64,
+    pub(crate) offset: u64,
+    pub(crate) bytes: u64,
+    pub(crate) result: i64,
+    pub(crate) file_id: u32,
+    pub(crate) command: u32,
+    pub(crate) priority: u32,
+    pub(crate) fd: i32,
+    pub(crate) kind: u8,
+    pub(crate) stage: u8,
+    pub(crate) path_len: u8,
+    pub(crate) path_truncated: bool,
+    pub(crate) path: [u8; PATH],
+}
+impl Item {
+    pub(crate) const EMPTY: Self = Self {id:0,parent:0,source_job:0,created_ns:0,changed_ns:0,
+        offset:0,bytes:0,result:0,file_id:0,command:0,priority:0,fd:-1,kind:0,stage:0,
+        path_len:0,path_truncated:false,path:[0;PATH]};
+}
+
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct Event {
+    pub(crate) seq: u64,
+    pub(crate) at_ns: u64,
+    pub(crate) stage_ns: u64,
+    pub(crate) ended: bool,
+    pub(crate) item: Item,
+}
+impl Event {
+    pub(crate) const EMPTY: Self = Self {seq:0,at_ns:0,stage_ns:0,ended:false,item:Item::EMPTY};
+}
+
+pub(crate) struct Store<const A: usize, const E: usize> {
+    items: [Item; A],
+    events: [Event; E],
+    pub(crate) next_seq: u64,
+    pub(crate) table_skips: u64,
+    pub(crate) missing_updates: u64,
+    pub(crate) active: u64,
+    pub(crate) hist: [[u64; BINS]; STAGES],
+}
+impl<const A: usize, const E: usize> Store<A,E> {
+    pub(crate) const fn new() -> Self {
+        Self {items:[Item::EMPTY;A],events:[Event::EMPTY;E],next_seq:1,
+              table_skips:0,missing_updates:0,active:0,hist:[[0;BINS];STAGES]}
+    }
+    fn slot(&self, id:u64) -> Option<usize> {
+        if id==0 || A==0 {return None;}
+        let start=(id % A as u64) as usize;
+        (0..A.min(16)).map(|n|(start+n)%A).find(|&i|self.items[i].id==id)
+    }
+    fn push(&mut self, item:Item, at:u64, span:u64, ended:bool) {
+        if E==0 {return;}
+        let seq=self.next_seq;
+        self.events[((seq-1)%E as u64) as usize]=Event {seq,at_ns:at,stage_ns:span,ended,item};
+        self.next_seq=self.next_seq.saturating_add(1);
+    }
+    fn bucket(&mut self, stage:u8, ns:u64) {
+        if stage as usize>=STAGES {return;}
+        // Inclusive upper bounds: 1 us, 2 us, ..., 2^30 us; final bin open.
+        let mut b=0;
+        while b<BINS-1 && ns>(1000u64<<b) {b+=1;}
+        self.hist[stage as usize][b]=self.hist[stage as usize][b].saturating_add(1);
+    }
+    pub(crate) fn begin(&mut self, mut item:Item, now:u64) {
+        if item.id==0 || A==0 {return;}
+        item.created_ns=now; item.changed_ns=now;
+        let start=(item.id%A as u64) as usize;
+        let slot=(0..A.min(16)).map(|n|(start+n)%A).find(|&i|self.items[i].id==0);
+        if let Some(i)=slot {self.items[i]=item;self.active+=1;}
+        else {self.table_skips=self.table_skips.saturating_add(1);}
+        self.push(item,now,0,false);
+    }
+    pub(crate) fn change(&mut self,id:u64,stage:u8,result:i64,now:u64,ended:bool) {
+        if id==0 {return;}
+        let Some(i)=self.slot(id) else {self.missing_updates=self.missing_updates.saturating_add(1);return;};
+        let mut item=self.items[i];
+        if item.stage==stage && !ended {return;}
+        let span=now.saturating_sub(item.changed_ns);
+        self.bucket(item.stage,span);
+        if ended {self.bucket(28+item.kind,now.saturating_sub(item.created_ns));}
+        item.stage=stage;item.result=result;item.changed_ns=now;
+        self.push(item,now,span,ended);
+        if ended {self.items[i]=Item::EMPTY;self.active=self.active.saturating_sub(1);}
+        else {self.items[i]=item;}
+    }
+    pub(crate) fn oldest(&self) -> u64 {self.next_seq.saturating_sub(E as u64).max(1)}
+    pub(crate) fn active_page(&self,cursor:usize,out:&mut [Item]) -> (usize,usize) {
+        let mut at=cursor.min(A);let mut n=0;
+        while at<A && n<out.len() {if self.items[at].id!=0 {out[n]=self.items[at];n+=1;}at+=1;}
+        (at,n)
+    }
+    pub(crate) fn event_page(&self,after:u64,out:&mut [Event]) -> (u64,usize,u64) {
+        let wanted=after.saturating_add(1);
+        let first=wanted.max(self.oldest());
+        let lost=self.oldest().saturating_sub(wanted);
+        let mut n=0;let mut seq=first;
+        while seq<self.next_seq && n<out.len() {
+            let event=self.events[((seq-1)%E as u64) as usize];
+            if event.seq==seq {out[n]=event;n+=1;}
+            seq+=1;
+        }
+        (if n>0 {out[n-1].seq} else {after},n,lost)
+    }
+}
+
+static LOCK: AtomicBool=AtomicBool::new(false);
+static NEXT_ID: AtomicU64=AtomicU64::new(1);
+static BOOT_NS: AtomicU64=AtomicU64::new(0);
+static DROPPED: AtomicU64=AtomicU64::new(0);
+static DATA: SyncCell<Store<ACTIVE_CAP,EVENT_CAP>>=SyncCell::new(Store::new());
+struct Guard;
+impl Drop for Guard {fn drop(&mut self){LOCK.store(false,Ordering::Release);}}
+fn with_store<T>(producer:bool,f:impl FnOnce(&mut Store<ACTIVE_CAP,EVENT_CAP>)->T)->Option<T> {
+    if LOCK.compare_exchange(false,true,Ordering::Acquire,Ordering::Relaxed).is_err() {
+        if producer {DROPPED.fetch_add(1,Ordering::Relaxed);}
+        return None;
+    }
+    let _guard=Guard;
+    Some(f(unsafe {&mut *DATA.get()}))
+}
