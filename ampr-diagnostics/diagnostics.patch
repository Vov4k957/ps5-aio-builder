+//! Bounded debug diagnostics. Completion publication is independent of the
+//! history lock; a busy HTTP reader cannot leave a finished operation active.
+//! Read lifecycles are sampled before path lookup. History keeps slow endings
+//! and long wait transitions rather than every tiny I/O state change.
+
+use core::sync::atomic::{AtomicBool, AtomicI64, AtomicU64, Ordering};
+use super::sync::SyncCell;
+
+pub(crate) const PROTOCOL:u64=2;
+pub(crate) const ACTIVE_CAP:usize=1024;
+pub(crate) const EVENT_CAP:usize=4096;
+pub(crate) const PAGE:usize=64;
+pub(crate) const PATH:usize=96;
+pub(crate) const STAGES:usize=32;
+pub(crate) const BINS:usize=32;
+pub(crate) const WAITS:usize=8;
+pub(crate) const JOB:u8=1;
+pub(crate) const READ:u8=2;
+pub(crate) const PREAD:u8=3;
+pub(crate) const JOB_ACCEPTED:u8=1;
+pub(crate) const JOB_ISSUED:u8=2;
+pub(crate) const JOB_READ_DONE:u8=3;
+pub(crate) const JOB_NOTIFIED:u8=4;
+pub(crate) const JOB_RELEASED:u8=5;
+pub(crate) const READ_LISTED:u8=10;
+pub(crate) const READ_ACCEPTED:u8=11;
+pub(crate) const READ_OBSERVED:u8=12;
+pub(crate) const READ_REMOVED:u8=13;
+pub(crate) const PREAD_QUEUED:u8=20;
+pub(crate) const PREAD_RUNNING:u8=21;
+pub(crate) const PREAD_FINISHED:u8=22;
+pub(crate) const WAIT_PRIOR:u8=1;
+pub(crate) const WAIT_GAME:u8=2;
+pub(crate) const WAIT_BUDGET:u8=3;
+pub(crate) const WAIT_WINDOW:u8=4;
+pub(crate) const WAIT_NATIVE:u8=5;
+pub(crate) const WAIT_READS:u8=6;
+pub(crate) const WAIT_ADMISSION:u8=7;
+pub(crate) const WAIT_OTHER:u8=8;
+pub(crate) const READ_EVERY:u64=16;
+pub(crate) const PREAD_EVERY:u64=64;
