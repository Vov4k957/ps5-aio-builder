+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn item(id:u64)->Item {Item {id,kind:READ,stage:READ_LISTED,..Item::EMPTY}}
+    #[test] fn lifecycle_and_distinct_ids(){
+        let mut s=Store::<8,16>::new();s.begin(item(1),10);s.begin(item(2),12);
+        s.change(1,READ_ACCEPTED,0,20,false);s.change(1,READ_REMOVED,-5,30,true);
+        assert_eq!(s.active,1);let mut out=[Item::EMPTY;4];let(_,n)=s.active_page(0,&mut out);
+        assert_eq!(n,1);assert_eq!(out[0].id,2);
+        let mut events=[Event::EMPTY;8];let(_,n,lost)=s.event_page(0,&mut events);
+        assert_eq!((n,lost),(4,0));assert!(events[3].ended);assert_eq!(events[3].item.result,-5);
+    }
+    #[test] fn overwrite_and_cursor_loss_are_explicit(){
+        let mut s=Store::<4,3>::new();s.begin(item(1),1);
+        s.change(1,READ_ACCEPTED,0,2,false);s.change(1,READ_OBSERVED,0,3,false);s.change(1,READ_REMOVED,0,4,true);
+        let mut out=[Event::EMPTY;2];let(next,n,lost)=s.event_page(0,&mut out);
+        assert_eq!((next,n,lost),(3,2,1));let(next,n,lost)=s.event_page(next,&mut out);
+        assert_eq!((next,n,lost),(4,1,0));
+    }
+    #[test] fn table_overflow_does_not_evict_live_requests(){
+        let mut s=Store::<2,8>::new();s.begin(item(1),1);s.begin(item(2),2);s.begin(item(3),3);
+        assert_eq!(s.active,2);assert_eq!(s.table_skips,1);s.change(3,READ_REMOVED,0,4,true);
+        assert_eq!(s.missing_updates,1);assert_eq!(s.active,2);
+    }
+    #[test] fn an_id_reuse_never_finishes_the_new_request(){
+        let mut s=Store::<2,8>::new();s.begin(item(1),1);s.change(1,READ_REMOVED,0,2,true);
+        s.begin(item(3),3);s.change(1,READ_REMOVED,0,4,true);assert_eq!(s.active,1);
+        assert_eq!(s.items[s.slot(3).unwrap()].created_ns,3);
+    }
+    #[test] fn duplicate_stage_is_not_a_fake_transition(){
+        let mut s=Store::<4,8>::new();s.begin(item(1),10);s.change(1,READ_LISTED,0,20,false);
+        assert_eq!(s.next_seq,2);assert_eq!(s.items[s.slot(1).unwrap()].changed_ns,10);
+    }
+    #[test] fn paginated_active_scan_does_not_repeat_slots(){
+        let mut s=Store::<8,8>::new();for id in 1..=5{s.begin(item(id),id);}
+        let mut out=[Item::EMPTY;2];let mut at=0;let mut ids=std::vec::Vec::new();
+        while at<8{let(next,n)=s.active_page(at,&mut out);ids.extend(out[..n].iter().map(|i|i.id));at=next;}
+        ids.sort_unstable();assert_eq!(ids,vec![1,2,3,4,5]);
+    }
+    #[test] fn histograms_use_completed_stage_spans_only(){
+        let mut s=Store::<4,8>::new();s.begin(item(1),100);assert_eq!(s.hist[READ_LISTED as usize].iter().sum::<u64>(),0);
+        s.change(1,READ_ACCEPTED,0,1100,false);s.change(1,READ_REMOVED,0,3100,true);
+        assert_eq!(s.hist[READ_LISTED as usize][0],1);assert_eq!(s.hist[READ_ACCEPTED as usize][1],1);
+        assert_eq!(s.hist[(28+READ) as usize][2],1);
+    }
+    #[test] fn backward_clock_never_underflows(){
+        let mut s=Store::<4,8>::new();s.begin(item(1),100);s.change(1,READ_REMOVED,0,20,true);
+        assert_eq!(s.hist[READ_LISTED as usize][0],1);
+    }
+    #[test] fn readers_and_producers_never_spin_on_a_busy_store(){
+        LOCK.store(true,Ordering::Release);let before=DROPPED.load(Ordering::Relaxed);
+        assert!(with_store(true,|_|()).is_none());assert_eq!(DROPPED.load(Ordering::Relaxed),before+1);
+        assert!(with_store(false,|_|()).is_none());assert_eq!(DROPPED.load(Ordering::Relaxed),before+1);
+        LOCK.store(false,Ordering::Release);
+    }
+    #[test] fn diagnostic_storage_budget(){
+        println!("diag storage: Item={} Event={} Store={} bytes",core::mem::size_of::<Item>(),core::mem::size_of::<Event>(),STORE_BYTES);
+        assert!(STORE_BYTES<2*1024*1024);assert_eq!(core::mem::align_of::<Item>(),8);
+    }
+    #[test] fn diagnostic_routes_and_bounds(){
+        assert_eq!(query(b"/metrics"),None);
+        assert_eq!(query(b"/diag/active?cursor=20&limit=4"),Some(Query::Active(20,4)));
+        assert_eq!(query(b"/diag/events?after=9000000000&limit=64"),Some(Query::Events(9000000000,64)));
+        for target in [b"/diag/events?after=-1" as &[u8],b"/diag/events?after=18446744073709551616",
+            b"/diag/active?cursor=1025",b"/diag/active?limit=0",b"/diag/active?limit=1000",
+            b"/diag/events?after=1&after=2",b"/diag/unknown",b"/diag/info?set=1"] {
+            assert_eq!(query(target),Some(Query::Invalid));
+        }
+    }
