+#[derive(Clone,Copy,Debug)]
+pub(crate) struct Item {
+    pub(crate) id:u64,pub(crate) parent:u64,pub(crate) source_job:u64,
+    pub(crate) created_ns:u64,pub(crate) changed_ns:u64,pub(crate) offset:u64,
+    pub(crate) bytes:u64,pub(crate) result:i64,pub(crate) file_id:u32,
+    pub(crate) command:u32,pub(crate) priority:u32,pub(crate) fd:i32,
+    pub(crate) kind:u8,pub(crate) stage:u8,pub(crate) path_len:u8,
+    pub(crate) path_truncated:bool,pub(crate) gapped:bool,pub(crate) wait_reason:u8,
+    pub(crate) wait_since_ns:u64,pub(crate) wait_blocker:u64,pub(crate) wait_opcode:u32,
+    pub(crate) wait_ns:[u64;WAITS],pub(crate) path:[u8;PATH],
+}
+impl Item {
+    pub(crate) const EMPTY:Self=Self {id:0,parent:0,source_job:0,created_ns:0,changed_ns:0,
+        offset:0,bytes:0,result:0,file_id:0,command:0,priority:0,fd:-1,kind:0,stage:0,
+        path_len:0,path_truncated:false,gapped:false,wait_reason:0,wait_since_ns:0,
+        wait_blocker:0,wait_opcode:0,wait_ns:[0;WAITS],path:[0;PATH]};
+}
+#[derive(Clone,Copy,Debug)]
+pub(crate) struct Event {
+    pub(crate) seq:u64,pub(crate) at_ns:u64,pub(crate) stage_ns:u64,
+    pub(crate) ended:bool,pub(crate) item:Item,
+}
+impl Event {pub(crate) const EMPTY:Self=Self {seq:0,at_ns:0,stage_ns:0,ended:false,item:Item::EMPTY};}
+
+// Slot identity includes a generation. Only a successful ACTIVE -> WRITING
+// CAS may publish an ending; a late/duplicate finish cannot touch a reused slot.
+struct Completion {
+    state:AtomicU64,at:AtomicU64,result:AtomicI64,stage:AtomicU64,gap_id:AtomicU64,wait_key:AtomicU64,block_key:AtomicU64,block_since:AtomicU64,
+}
+impl Completion {
+    const fn new()->Self {Self {state:AtomicU64::new(0),at:AtomicU64::new(0),
+        result:AtomicI64::new(0),stage:AtomicU64::new(0),gap_id:AtomicU64::new(0),wait_key:AtomicU64::new(0),block_key:AtomicU64::new(0),block_since:AtomicU64::new(0)}}
+    fn activate(&self,id:u64) {self.block_key.store(0,Ordering::Relaxed);self.block_since.store(0,Ordering::Relaxed);self.gap_id.store(0,Ordering::Relaxed);self.wait_key.store(0,Ordering::Relaxed);self.state.store((id<<2)|1,Ordering::Release);}
+    fn complete(&self,id:u64,stage:u8,result:i64,now:u64)->bool {
+        if self.state.compare_exchange((id<<2)|1,(id<<2)|2,Ordering::Acquire,Ordering::Relaxed).is_err(){return false;}
+        self.at.store(now,Ordering::Relaxed);self.result.store(result,Ordering::Relaxed);
+        self.stage.store(stage as u64,Ordering::Relaxed);
+        self.state.store((id<<2)|3,Ordering::Release);true
+    }
+    fn pending(&self,id:u64)->Option<(u8,i64,u64)> {
+        if self.state.load(Ordering::Acquire)!=((id<<2)|3){return None;}
+        Some((self.stage.load(Ordering::Relaxed)as u8,self.result.load(Ordering::Relaxed),self.at.load(Ordering::Relaxed)))
+    }
+    fn live(&self,id:u64)->bool {self.state.load(Ordering::Acquire)==((id<<2)|1)}
+    fn observe_block(&self,id:u64,command:u32,reason:u8,opcode:u8,clock:impl FnOnce()->u64)->bool {
+        if !self.live(id){return false;}
+        let key=((command as u64)<<16)|((opcode as u64)<<8)|reason as u64;
+        if self.block_key.load(Ordering::Relaxed)==key{return true;}
+        self.block_since.store(clock(),Ordering::Relaxed);self.block_key.store(key,Ordering::Release);true
+    }
+    fn clear_block(&self,id:u64){if self.live(id){self.block_key.store(0,Ordering::Release);self.block_since.store(0,Ordering::Relaxed);}}
+    fn current_block(&self,id:u64,command:u32)->(u64,u64){
+        if !self.live(id){return (0,0);}let key=self.block_key.load(Ordering::Acquire);
+        if key!=0&&(key>>16)==command as u64{(key,self.block_since.load(Ordering::Relaxed))}else{(0,0)}
+    }
+}
+
+pub(crate) struct Store<const A:usize,const E:usize> {
+    items:[Item;A],events:[Event;E],pub(crate) next_seq:u64,pub(crate) table_skips:u64,
+    pub(crate) missing_updates:u64,pub(crate) active:u64,pub(crate) hist:[[u64;BINS];STAGES],
+    reap_cursor:usize,pub(crate) reaped:u64,pub(crate) filtered:u64,
+}
+impl<const A:usize,const E:usize> Store<A,E> {
+    pub(crate) const fn new()->Self {Self {items:[Item::EMPTY;A],events:[Event::EMPTY;E],next_seq:1,
+        table_skips:0,missing_updates:0,active:0,hist:[[0;BINS];STAGES],reap_cursor:0,reaped:0,filtered:0}}
+    fn slot(&self,id:u64)->Option<usize> {
+        if id==0||A==0{return None;}let i=(id%A as u64)as usize;
+        (self.items[i].id==id).then_some(i)
+    }
+    fn push(&mut self,item:Item,at:u64,span:u64,ended:bool) {
+        if E==0{return;}let seq=self.next_seq;
+        self.events[((seq-1)%E as u64)as usize]=Event {seq,at_ns:at,stage_ns:span,ended,item};
+        self.next_seq=self.next_seq.saturating_add(1);
+    }
+    fn bucket(&mut self,stage:u8,ns:u64) {
+        if stage as usize>=STAGES{return;}let mut b=0;
+        while b<BINS-1&&ns>(1000u64<<b){b+=1;}
+        self.hist[stage as usize][b]=self.hist[stage as usize][b].saturating_add(1);
+    }
+    fn reap_slot(&mut self,i:usize,done:&[Completion;A]) {
+        let id=self.items[i].id;if id==0{return;}
+        if let Some((stage,result,now))=done[i].pending(id) {
+            self.change(id,stage,result,now,true,done);
+            done[i].state.store(0,Ordering::Release);self.reaped=self.reaped.saturating_add(1);
+        }
+    }
+    fn reap(&mut self,done:&[Completion;A],budget:usize) {
+        if A==0{return;}for _ in 0..budget.min(A) {let i=self.reap_cursor;self.reap_cursor=(i+1)%A;self.reap_slot(i,done);}
+    }
+    fn begin(&mut self,mut item:Item,now:u64,done:&[Completion;A])->u64 {
+        if item.id==0||A==0||item.id>=(1u64<<60)/(A as u64){return 0;}
+        self.reap(done,8);let start=(item.id%A as u64)as usize;
+        for n in 0..A.min(32) {
+            let i=(start+n)%A;self.reap_slot(i,done);
+            if self.items[i].id!=0{continue;}
+            item.id=item.id*A as u64+i as u64;item.created_ns=now;item.changed_ns=now;
+            if item.kind==JOB{item.wait_reason=WAIT_OTHER;item.wait_since_ns=now;}
+            self.items[i]=item;done[i].activate(item.id);
+            done[i].wait_key.store((item.wait_reason as u64)<<32,Ordering::Relaxed);self.active+=1;return item.id;
+        }
+        self.table_skips=self.table_skips.saturating_add(1);0
+    }
+    fn close_wait(item:&mut Item,now:u64) {
+        if item.wait_reason>0&&item.wait_reason as usize<=WAITS {
+            let i=(item.wait_reason-1)as usize;
+            item.wait_ns[i]=item.wait_ns[i].saturating_add(now.saturating_sub(item.wait_since_ns));
+        }
+        item.wait_since_ns=now;
+    }
+    fn wait(&mut self,id:u64,reason:u8,blocker:u64,opcode:u32,now:u64,done:&[Completion;A],only_queued:bool) {
+        let Some(i)=self.slot(id)else{return;};
+        if !done[i].live(id)||self.items[i].stage!=JOB_ACCEPTED{return;}
+        if only_queued&&self.items[i].wait_reason!=WAIT_PRIOR{return;}
+        let mut item=self.items[i];
+        if reason>WAITS as u8||(item.wait_reason==reason&&item.wait_blocker==blocker&&item.wait_opcode==opcode){return;}
+        item.gapped|=done[i].gap_id.load(Ordering::Relaxed)==id;
+        let since=item.wait_since_ns;let span=now.saturating_sub(since);Self::close_wait(&mut item,now);
+        if span>=100_000_000{let mut closed=item;closed.wait_since_ns=since;self.push(closed,now,span,false);}
+        item.wait_reason=reason;item.wait_blocker=blocker;item.wait_opcode=opcode;
+        self.items[i]=item;done[i].wait_key.store(((reason as u64)<<32)|opcode as u64,Ordering::Relaxed);
+    }
+    fn change(&mut self,id:u64,stage:u8,result:i64,now:u64,ended:bool,done:&[Completion;A]) {
+        if id==0{return;}let Some(i)=self.slot(id)else{self.missing_updates=self.missing_updates.saturating_add(1);return;};
+        let mut item=self.items[i];item.gapped|=done[i].gap_id.load(Ordering::Relaxed)==id;
+        if item.stage==stage&&!ended{return;}
+        let span=now.saturating_sub(item.changed_ns);
+        if !item.gapped{self.bucket(item.stage,span);}
+        if ended||stage==JOB_ISSUED {Self::close_wait(&mut item,now);item.wait_reason=0;item.wait_blocker=0;}
+        if ended {self.bucket(28+item.kind,now.saturating_sub(item.created_ns));}
+        item.stage=stage;item.result=result;item.changed_ns=now;
+        if ended {
+            let slow=now.saturating_sub(item.created_ns)>=match item.kind{JOB=>50_000_000,READ=>20_000_000,_=>10_000_000};
+            if slow||result<0||((item.id/A as u64)%16==0){self.push(item,now,span,true);}else{self.filtered=self.filtered.saturating_add(1);}
+            self.items[i]=Item::EMPTY;self.active=self.active.saturating_sub(1);
+        }else{self.items[i]=item;}
+    }
+    pub(crate) fn oldest(&self)->u64{self.next_seq.saturating_sub(E as u64).max(1)}
+    fn active_page(&mut self,cursor:usize,out:&mut [Item],done:&[Completion;A])->(usize,usize) {
+        self.reap(done,A);let mut at=cursor.min(A);let mut n=0;
+        while at<A&&n<out.len(){let mut item=self.items[at];
+            if item.id!=0&&done[at].live(item.id){item.gapped|=done[at].gap_id.load(Ordering::Relaxed)==item.id;out[n]=item;n+=1;}at+=1;}
+        (at,n)
+    }
+    pub(crate) fn event_page(&self,after:u64,out:&mut [Event])->(u64,usize,u64) {
+        let wanted=after.saturating_add(1);let first=wanted.max(self.oldest());let lost=self.oldest().saturating_sub(wanted);
+        let mut n=0;let mut seq=first;
+        while seq<self.next_seq&&n<out.len(){let event=self.events[((seq-1)%E as u64)as usize];if event.seq==seq{out[n]=event;n+=1;}seq+=1;}
+        (if n>0{out[n-1].seq}else{after},n,lost)
+    }
+}
+
+static LOCK:AtomicBool=AtomicBool::new(false);
+static NEXT_ID:AtomicU64=AtomicU64::new(1);
+static BOOT_NS:AtomicU64=AtomicU64::new(0);
+static DROPPED:AtomicU64=AtomicU64::new(0);
+static BEGIN_SKIPS:AtomicU64=AtomicU64::new(0);
+static DEFERRED:AtomicU64=AtomicU64::new(0);
+static SEEN:[AtomicU64;3]=[const{AtomicU64::new(0)};3];
+static DONE:[Completion;ACTIVE_CAP]=[const{Completion::new()};ACTIVE_CAP];
+static DATA:SyncCell<Store<ACTIVE_CAP,EVENT_CAP>>=SyncCell::new(Store::new());
+struct Guard;
+impl Drop for Guard{fn drop(&mut self){LOCK.store(false,Ordering::Release);}}
+fn with_store<T>(f:impl FnOnce(&mut Store<ACTIVE_CAP,EVENT_CAP>)->T)->Option<T> {
+    if LOCK.compare_exchange(false,true,Ordering::Acquire,Ordering::Relaxed).is_err(){return None;}
+    let _guard=Guard;Some(f(unsafe{&mut *DATA.get()}))
+}
+#[cfg(feature="mem_report")]
+fn clock()->u64{super::stats::now()}
+#[cfg(feature="mem_report")]
+fn selected(kind:u8)->bool {
+    if !(JOB..=PREAD).contains(&kind){return false;}
+    let n=SEEN[(kind-1)as usize].fetch_add(1,Ordering::Relaxed);
+    n%match kind{READ=>READ_EVERY,PREAD=>PREAD_EVERY,_=>1}==0
+}
+#[cfg(feature="mem_report")]
+fn begin_selected(mut item:Item,path:&[u8],truncated:bool)->u64 {
+    let serial=NEXT_ID.fetch_add(1,Ordering::Relaxed);let now=clock();
+    let _=BOOT_NS.compare_exchange(0,now.max(1),Ordering::Relaxed,Ordering::Relaxed);
+    item.id=serial;let n=path.len().min(PATH);item.path[..n].copy_from_slice(&path[..n]);
+    item.path_len=n as u8;item.path_truncated=truncated||path.len()>PATH;
+    with_store(|s|s.begin(item,now,&DONE)).unwrap_or_else(||{BEGIN_SKIPS.fetch_add(1,Ordering::Relaxed);0})
+}
+#[cfg(feature="mem_report")]
+pub(crate) fn begin(item:Item,path:&[u8],truncated:bool)->u64 {
+    if !selected(item.kind){return 0;}begin_selected(item,path,truncated)
+}
+#[cfg(feature="mem_report")]
+pub(crate) fn change(id:u64,stage:u8) {
+    if id==0{return;}let i=(id%ACTIVE_CAP as u64)as usize;
+    if with_store(|s|{s.reap(&DONE,8);if DONE[i].live(id){s.change(id,stage,0,clock(),false,&DONE);}}).is_none(){
+        DONE[i].gap_id.store(id,Ordering::Relaxed);DROPPED.fetch_add(1,Ordering::Relaxed);
+    }
+}
+#[cfg(feature="mem_report")]
+pub(crate) fn finish(id:u64,stage:u8,result:i64) {
+    if id==0{return;}let i=(id%ACTIVE_CAP as u64)as usize;
+    if !DONE[i].complete(id,stage,result,clock()){return;}
+    if with_store(|s|s.reap_slot(i,&DONE)).is_none(){DEFERRED.fetch_add(1,Ordering::Relaxed);}
+}
+// The block tag follows the command cursor after the first read too. Only
+// the reactor writes a live job's tag; it does not need the history lock.
+#[cfg(feature="mem_report")]
+pub(crate) fn job_block(job:&super::reactor::JobState,reason:u8,opcode:u8) {
+    if job.diagId==0{return;}let id=job.diagId;let i=(id%ACTIVE_CAP as u64)as usize;
+    let _=DONE[i].observe_block(id,job.sourceCommandIndex,reason,opcode,clock);
+}
+#[cfg(feature="mem_report")]
+pub(crate) fn job_progress(job:&super::reactor::JobState) {
+    if job.diagId!=0{let id=job.diagId;DONE[(id%ACTIVE_CAP as u64)as usize].clear_block(id);}
+}
+#[cfg(feature="mem_report")]
+pub(crate) fn block_state(job:&super::reactor::JobState)->(u64,u64) {
+    if job.diagId==0{return (0,0);}let id=job.diagId;
+    DONE[(id%ACTIVE_CAP as u64)as usize].current_block(id,job.sourceCommandIndex)
+}
+#[cfg(feature="mem_report")]
+pub(crate) fn boot_ns()->u64{BOOT_NS.load(Ordering::Relaxed)}
+#[cfg(feature="mem_report")]
+pub(crate) fn job_wait(job:&super::reactor::JobState,reason:u8,blocker:u64,opcode:u8) {
+    job_block(job,reason,opcode);
+    if job.statAcceptNs==0||job.diagId==0{return;}
+    let id=job.diagId;let i=(id%ACTIVE_CAP as u64)as usize;
+    // Repeated checks on the same blocked command do not acquire the store
+    // lock or read the clock. A failed transition is retried on the next pass.
+    if !DONE[i].live(id)||DONE[i].wait_key.load(Ordering::Relaxed)==(((reason as u64)<<32)|opcode as u64){return;}
+    if with_store(|s|s.wait(id,reason,blocker,opcode as u32,clock(),&DONE,false)).is_none(){
+        DONE[i].gap_id.store(id,Ordering::Relaxed);DROPPED.fetch_add(1,Ordering::Relaxed);
+    }
+}
+#[cfg(feature="mem_report")]
+pub(crate) fn job_enter(job:&super::reactor::JobState) {
+    let (key,_)=block_state(job);
+    if (key&255)==WAIT_PRIOR as u64 || (key!=0 && (key>>16)!=job.sourceCommandIndex as u64) {job_progress(job);}
+    if job.statAcceptNs==0||job.diagId==0{return;}
+    let id=job.diagId;let i=(id%ACTIVE_CAP as u64)as usize;
+    if !DONE[i].live(id)||(DONE[i].wait_key.load(Ordering::Relaxed)>>32)!=WAIT_PRIOR as u64{return;}
+    if with_store(|s|s.wait(id,WAIT_OTHER,0,0,clock(),&DONE,true)).is_none(){
+        DONE[i].gap_id.store(id,Ordering::Relaxed);DROPPED.fetch_add(1,Ordering::Relaxed);
+    }
+}
+#[cfg(feature="mem_report")]
+pub(crate) fn begin_read(read:&super::reactor::ActiveRead)->u64 {
+    if !selected(READ){return 0;}let job=unsafe{read.job.as_ref()};let mut path=[0u8;PATH+1];
+    let n=super::index::probe_file_path(read.desc.fileId,&mut path).unwrap_or(0);
+    begin_selected(Item {parent:job.map_or(0,|j|j.diagId),source_job:job.map_or(0,|j|j.id),
+        kind:READ,stage:READ_LISTED,fd:read.desc.fd,file_id:read.desc.fileId,
+        offset:read.desc.offset,bytes:read.desc.length,command:read.commandIndex as u32,
+        priority:read.aioPrio as u32,..Item::EMPTY},&path[..n],n==PATH)
+}
+#[cfg(feature="mem_report")]
+pub(crate) fn begin_pread(item:Item)->u64 {
+    if !selected(PREAD){return 0;}let mut path=[0u8;PATH+1];
+    let n=super::index::probe_file_path(item.file_id,&mut path).unwrap_or(0);
+    begin_selected(item,&path[..n],n==PATH)
+}
+#[derive(Clone,Copy)]
+pub(crate) struct Header {
+    pub(crate) now_ns:u64,pub(crate) boot_ns:u64,pub(crate) dropped:u64,
+    pub(crate) table_skips:u64,pub(crate) missing:u64,pub(crate) active:u64,
+    pub(crate) oldest:u64,pub(crate) next_seq:u64,pub(crate) busy:bool,
+    pub(crate) begin_skips:u64,pub(crate) deferred:u64,pub(crate) reaped:u64,
+    pub(crate) filtered:u64,pub(crate) seen:[u64;3],
+}
+impl Header {
+    fn read(s:&Store<ACTIVE_CAP,EVENT_CAP>,now:u64)->Self {
+        Self{now_ns:now,boot_ns:BOOT_NS.load(Ordering::Relaxed),dropped:DROPPED.load(Ordering::Relaxed),
+            table_skips:s.table_skips,missing:s.missing_updates,active:s.active,oldest:s.oldest(),next_seq:s.next_seq,
+            busy:false,begin_skips:BEGIN_SKIPS.load(Ordering::Relaxed),deferred:DEFERRED.load(Ordering::Relaxed),
+            reaped:s.reaped,filtered:s.filtered,seen:core::array::from_fn(|i|SEEN[i].load(Ordering::Relaxed))}
+    }
+}
+#[cfg(feature="mem_report")]
+pub(crate) fn active_snapshot(cursor:usize,out:&mut [Item])->(Header,usize,usize) {
+    with_store(|s|{let(next,n)=s.active_page(cursor,out,&DONE);(Header::read(s,clock()),next,n)}).unwrap_or((busy_header(),cursor,0))
+}
+#[cfg(feature="mem_report")]
+pub(crate) fn event_snapshot(after:u64,out:&mut [Event])->(Header,u64,usize,u64) {
+    with_store(|s|{s.reap(&DONE,ACTIVE_CAP);let(next,n,lost)=s.event_page(after,out);(Header::read(s,clock()),next,n,lost)}).unwrap_or((busy_header(),after,0,0))
+}
+#[cfg(feature="mem_report")]
+pub(crate) fn histogram_snapshot(out:&mut [[u64;BINS];STAGES])->Header {
+    with_store(|s|{s.reap(&DONE,ACTIVE_CAP);*out=s.hist;Header::read(s,clock())}).unwrap_or_else(busy_header)
+}
+#[cfg(feature="mem_report")]
+fn busy_header()->Header {
+    Header {now_ns:clock(),boot_ns:BOOT_NS.load(Ordering::Relaxed),dropped:DROPPED.load(Ordering::Relaxed),
+        table_skips:0,missing:0,active:0,oldest:0,next_seq:0,busy:true,
+        begin_skips:BEGIN_SKIPS.load(Ordering::Relaxed),deferred:DEFERRED.load(Ordering::Relaxed),reaped:0,filtered:0,seen:[0;3]}
+}
+pub(crate) const STORE_BYTES:usize=core::mem::size_of::<Store<ACTIVE_CAP,EVENT_CAP>>()+core::mem::size_of::<[Completion;ACTIVE_CAP]>();
+#[cfg(feature="mem_report")]
+pub(crate) fn init(now:u64){let _=BOOT_NS.compare_exchange(0,now.max(1),Ordering::Relaxed,Ordering::Relaxed);}
+
+/// Deliberately exact routes. An invalid diagnostic request must not fall
+/// through to /metrics, whose resetting maxima would then be consumed.
+#[derive(Clone,Copy,Debug,PartialEq,Eq)]
+pub(crate) enum Query {Info, Active(usize,usize), Events(u64,usize), Heads(u64,usize), Hist, Invalid}
+pub(crate) fn query(target:&[u8])->Option<Query> {
+    if !target.starts_with(b"/diag") {return None;}
+    let at=target.iter().position(|&b|b==b'?').unwrap_or(target.len());
+    let route=&target[..at];
+    let params=if at<target.len(){&target[at+1..]}else{&[]};
+    if route==b"/diag/info" {return Some(if params.is_empty(){Query::Info}else{Query::Invalid});}
+    if route==b"/diag/hist" {return Some(if params.is_empty(){Query::Hist}else{Query::Invalid});}
+    let mut cursor=0u64;let mut limit=PAGE;let mut seen_cursor=false;let mut seen_limit=false;
+    for part in params.split(|&b|b==b'&').filter(|p|!p.is_empty()) {
+        let Some(eq)=part.iter().position(|&b|b==b'=') else{return Some(Query::Invalid);};
+        let (key,value)=(&part[..eq],&part[eq+1..]);
+        if value.is_empty(){return Some(Query::Invalid);}
+        let mut number=0u64;
+        for &b in value {if !b.is_ascii_digit(){return Some(Query::Invalid);}
+            let Some(n)=number.checked_mul(10).and_then(|n|n.checked_add((b-b'0')as u64)) else{return Some(Query::Invalid);};number=n;}
+        if key==b"limit" && !seen_limit {if number==0||number>PAGE as u64{return Some(Query::Invalid);}limit=number as usize;seen_limit=true;}
+        else if ((route==b"/diag/active"&&key==b"cursor")||((route==b"/diag/events"||route==b"/diag/heads")&&key==b"after")) && !seen_cursor {cursor=number;seen_cursor=true;}
+        else{return Some(Query::Invalid);}
+    }
+    Some(match route {
+        b"/diag/active" if cursor<=ACTIVE_CAP as u64=>Query::Active(cursor as usize,limit),
+        b"/diag/events"=>Query::Events(cursor,limit),
+        b"/diag/heads"=>Query::Heads(cursor,limit),
+        _=>Query::Invalid,
+    })
+}
