@@ -0,0 +1,54 @@
+//! Scalar lane-head copies made by the reactor under its existing job lock.
+//! The observer never polls completion, evaluates game memory, or changes a
+//! scheduler decision. Paths are resolved later on the HTTP thread.
+use super::*;
+use crate::rt::{diag,diag_heads};
+impl AprAioReactor {
+    pub(crate) fn diag_capture_heads(&self,heads:&[JobPtr;PRIO_N],now:u64){
+        let mut output=[diag_heads::Head::EMPTY;PRIO_N];
+        let mut queued=0;let mut running=0;
+        for task in &self.preadTasks{match task.state.load(Ordering::Acquire){PREAD_QUEUED=>queued+=1,PREAD_RUNNING=>running+=1,_=>{}}}
+        for (lane,&pointer) in heads.iter().enumerate(){
+            let h=&mut output[lane];h.lane=lane as u32;
+            h.pread_queued=queued;h.pread_running=running;
+            h.pread_pending=self.preadPendingCount;h.pread_threads=self.preadThreadCount as u32;
+            let Some(j)=(unsafe{pointer.as_ref()})else{continue;};
+            h.source_job=j.id;h.diag_id=j.diagId;h.command_index=j.sourceCommandIndex;h.command_count=j.commandCount;
+            h.source_offset=j.sourceOffset;h.source_bytes=j.sourceBytes;
+            h.active_reads=j.activeReadCount;h.read_seq_latest=j.latestSubmittedReadSeq;h.read_seq_completed=j.completedReadSeq;
+            h.native_opcode=j.nativeSourceType as u32;h.native_retry_at_ns=j.nativeSubmitRetryAtNs;
+            if j.nativeSubmitted.load(Ordering::Acquire){h.flags|=1;}
+            if j.nativeBatchReleasePending{h.flags|=2;}
+            let native=&self.nativeBatchLanes[lane];
+            if native.blockingWaitSequence!=0&&!Self::native_batch_sequence_reached(native.completedSequence,native.blockingWaitSequence){h.flags|=4;}
+            if j.failed.load(Ordering::Acquire){h.flags|=8;}
+            if j.processingComplete{h.flags|=16;}
+            if j.decodedOpCacheBytes!=0&&j.decodedOpCache.buf_offset_bytes==j.sourceOffset {
+                h.flags|=32;h.cursor_opcode=j.decodedOpCache.op_type as u32;
+            }
+            if j.statAcceptNs==0{h.flags|=64;}
+            if j.sourceOffset==j.sourceBytes{h.flags|=128;}
+            if !j.priorityNext.load(Ordering::Acquire).is_null(){h.flags|=256;}
+            if j.diagId==0{h.flags|=512;}
+            let(key,since)=diag::block_state(j);
+            h.block_reason=if key==0{8}else{(key&255)as u32};h.block_since_ns=since;h.block_opcode=((key>>8)&255)as u32;
+            if let Some(chain)=unsafe{j.cursorReadChain.as_ref()}{
+                h.chain_active_reads=chain.activeCount;h.chain_active_bytes=chain.activeBytes;h.chain_retry_at_ns=chain.retryNotBeforeNs;
+                h.file_id=chain.ownerDesc.fileId;h.fd=chain.ownerDesc.fd;h.file_offset=chain.ownerDesc.offset;
+                h.read_bytes=chain.ownerDesc.length;h.read_flags|=32;
+            }
+            if let Some(slot)=self.activeReads.slots_.get(j.activeReadHead as usize){
+                if slot.active&&slot.value.job==pointer{
+                    let read=&slot.value;
+                    h.file_id=read.desc.fileId;h.fd=read.desc.fd;h.file_offset=read.desc.offset;h.read_bytes=read.desc.length;
+                    h.read_submit_ns=read.statSubmitNs;h.read_flags=1;
+                    if read.submitAccounted{h.read_flags|=2;}
+                    if read.preadQueued{h.read_flags|=4;}
+                    if read.awaitingResubmit{h.read_flags|=8;}
+                    if read.awaitingBatchSubmit{h.read_flags|=16;}
+                }
+            }
+        }
+        diag_heads::publish(&output,now);
+    }
+}
