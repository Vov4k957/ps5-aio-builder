+//! Reactor-owned lane-head observations, independent of lifecycle history.
+//! Samples are points in time, not frame timings or a proof that a condition
+//! held between samples. The HTTP thread reads copies and never reads jobs.
+use core::sync::atomic::{AtomicBool,AtomicU64,Ordering};
+use super::sync::SyncCell;
+
+pub(crate) const PROTOCOL:u64=1;
+pub(crate) const LANES:usize=super::reactor::PRIO_N;
+pub(crate) const CAP:usize=1024;
+pub(crate) const PERIOD_NS:u64=100_000_000;
+pub(crate) const PAGE:usize=64;
+
+#[derive(Clone,Copy,Debug,Default)]
+pub(crate) struct Head {
+    pub(crate) lane:u32,pub(crate) source_job:u64,pub(crate) diag_id:u64,
+    pub(crate) observed_ns:u64,pub(crate) first_seen_ns:u64,pub(crate) contiguous:u32,
+    pub(crate) block_reason:u32,pub(crate) block_since_ns:u64,pub(crate) block_opcode:u32,
+    pub(crate) command_index:u32,pub(crate) command_count:u32,
+    pub(crate) source_offset:u32,pub(crate) source_bytes:u32,pub(crate) cursor_opcode:u32,
+    pub(crate) flags:u32,
+    pub(crate) active_reads:u32,pub(crate) read_seq_latest:u64,pub(crate) read_seq_completed:u64,
+    pub(crate) native_opcode:u32,pub(crate) native_retry_at_ns:u64,
+    pub(crate) file_id:u32,pub(crate) fd:i32,pub(crate) file_offset:u64,pub(crate) read_bytes:u64,
+    pub(crate) read_submit_ns:u64,pub(crate) read_flags:u32,
+    pub(crate) chain_active_reads:u32,pub(crate) chain_active_bytes:u64,pub(crate) chain_retry_at_ns:u64,
+    pub(crate) pread_queued:u32,pub(crate) pread_running:u32,pub(crate) pread_pending:u32,pub(crate) pread_threads:u32,
+}
+impl Head {
+    pub(crate) const EMPTY:Self=Self {lane:0,source_job:0,diag_id:0,observed_ns:0,first_seen_ns:0,contiguous:0,
+        block_reason:0,block_since_ns:0,block_opcode:0,command_index:0,command_count:0,
+        source_offset:0,source_bytes:0,cursor_opcode:256,flags:0,
+        active_reads:0,read_seq_latest:0,read_seq_completed:0,native_opcode:0,native_retry_at_ns:0,
+        file_id:0,fd:-1,file_offset:0,read_bytes:0,read_submit_ns:0,read_flags:0,
+        chain_active_reads:0,chain_active_bytes:0,chain_retry_at_ns:0,
+        pread_queued:0,pread_running:0,pread_pending:0,pread_threads:0};
+}
+#[derive(Clone,Copy,Debug)]
+pub(crate) struct Row {pub(crate) seq:u64,pub(crate) head:Head}
+impl Row {pub(crate) const EMPTY:Self=Self {seq:0,head:Head::EMPTY};}
+
+struct Store<const L:usize,const C:usize> {last:[Head;L],rows:[Row;C],next:u64,samples:u64}
+impl<const L:usize,const C:usize> Store<L,C> {
+    const fn new()->Self{Self {last:[Head::EMPTY;L],rows:[Row::EMPTY;C],next:1,samples:0}}
+    fn observe(&mut self,heads:&[Head;L],now:u64){
+        self.samples=self.samples.saturating_add(1);
+        for (lane,input) in heads.iter().enumerate(){
+            let previous=self.last[lane];let mut h=*input;h.lane=lane as u32;h.observed_ns=now;
+            if h.source_job==0&&previous.source_job==0{continue;}
+            let close=now>=previous.observed_ns&&now-previous.observed_ns<=PERIOD_NS*3;
+            if h.source_job!=0&&h.source_job==previous.source_job&&close {
+                h.first_seen_ns=previous.first_seen_ns;h.contiguous=1;
+            }else{h.first_seen_ns=now;h.contiguous=0;}
+            if C!=0{let seq=self.next;self.rows[((seq-1)%C as u64)as usize]=Row {seq,head:h};self.next=self.next.saturating_add(1);}
+            self.last[lane]=h;
+        }
+    }
+    fn oldest(&self)->u64{self.next.saturating_sub(C as u64).max(1)}
+    fn page(&self,after:u64,out:&mut [Row])->(u64,usize,u64){
+        let wanted=after.saturating_add(1);let first=wanted.max(self.oldest());let lost=self.oldest().saturating_sub(wanted);
+        let mut n=0;let mut seq=first;
+        while seq<self.next&&n<out.len(){let row=self.rows[((seq-1)%C as u64)as usize];if row.seq==seq{out[n]=row;n+=1;}seq+=1;}
+        (if n>0{out[n-1].seq}else{after},n,lost)
+    }
+}
+struct Gate {next:AtomicU64}
+impl Gate {
+    const fn new()->Self{Self {next:AtomicU64::new(0)}}
+    fn take(&self,now:u64)->bool {
+        let next=self.next.load(Ordering::Relaxed);if now<next{return false;}
+        self.next.compare_exchange(next,now.saturating_add(PERIOD_NS),Ordering::Relaxed,Ordering::Relaxed).is_ok()
+    }
+}
+static GATE:Gate=Gate::new();
+static LOCK:AtomicBool=AtomicBool::new(false);
+static DROPPED:AtomicU64=AtomicU64::new(0);
+static DATA:SyncCell<Store<LANES,CAP>>=SyncCell::new(Store::new());
+struct Guard;
+impl Drop for Guard{fn drop(&mut self){LOCK.store(false,Ordering::Release);}}
+fn with_store<T>(f:impl FnOnce(&mut Store<LANES,CAP>)->T)->Option<T>{
+    if LOCK.compare_exchange(false,true,Ordering::Acquire,Ordering::Relaxed).is_err(){return None;}
+    let _guard=Guard;Some(f(unsafe{&mut *DATA.get()}))
+}
+#[cfg(feature="mem_report")]
+pub(crate) fn due(now:u64)->bool{GATE.take(now)}
+#[cfg(feature="mem_report")]
+pub(crate) fn publish(heads:&[Head;LANES],now:u64){
+    if with_store(|s|s.observe(heads,now)).is_none(){DROPPED.fetch_add(1,Ordering::Relaxed);}
+}
+#[derive(Clone,Copy)]
+pub(crate) struct Header {pub(crate) now:u64,pub(crate) boot:u64,pub(crate) busy:bool,
+    pub(crate) dropped:u64,pub(crate) samples:u64,pub(crate) oldest:u64,pub(crate) next:u64}
+#[cfg(feature="mem_report")]
+pub(crate) fn snapshot(after:u64,out:&mut [Row])->(Header,u64,usize,u64){
+    let now=super::stats::now();let boot=super::diag::boot_ns();let dropped=DROPPED.load(Ordering::Relaxed);
+    with_store(|s|{let(next,n,lost)=s.page(after,out);let now=super::stats::now();
+        (Header{now,boot,busy:false,dropped,samples:s.samples,oldest:s.oldest(),next:s.next},next,n,lost)})
+        .unwrap_or((Header{now,boot,busy:true,dropped,samples:0,oldest:0,next:0},after,0,0))
+}
+pub(crate) const STORE_BYTES:usize=core::mem::size_of::<Store<LANES,CAP>>();
+
+#[cfg(test)]mod tests {
+    use super::*;
+    fn h(job:u64)->Head{Head{source_job:job,..Head::EMPTY}}
+    #[test]fn stable_head_is_sampled_after_its_first_read(){
+        let mut s=Store::<1,8>::new();let mut head=h(7);head.flags=64;head.block_reason=6;head.active_reads=4;
+        s.observe(&[head],100);s.observe(&[head],PERIOD_NS+100);
+        let mut rows=[Row::EMPTY;8];let(_,n,lost)=s.page(0,&mut rows);
+        assert_eq!((n,lost),(2,0));assert_eq!(rows[1].head.first_seen_ns,100);
+        assert_eq!(rows[1].head.contiguous,1);assert_eq!(rows[1].head.block_reason,6);assert_eq!(rows[1].head.active_reads,4);
+    }
+    #[test]fn a_gap_or_new_head_does_not_invent_continuous_occupation(){
+        let mut s=Store::<1,8>::new();s.observe(&[h(1)],100);s.observe(&[h(1)],PERIOD_NS*4);
+        assert_eq!(s.last[0].first_seen_ns,PERIOD_NS*4);assert_eq!(s.last[0].contiguous,0);
